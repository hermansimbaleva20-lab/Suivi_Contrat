# ============================================================================
# PRISE / PREDIRE — modèle de configuration de PRODUCTION
# Copiez ce fichier en .env sur le serveur, remplacez chaque valeur entre < >, puis lancez :
#   php artisan key:generate
#   php artisan prise:verifier-securite      (doit afficher « Configuration prête pour la mise en ligne. »)
# Ne mettez jamais le fichier .env dans git ni dans un dossier servi par le serveur web.
# ============================================================================

APP_NAME="PRISE / PREDIRE"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<api.domaine.cd>
APP_TIMEZONE=Africa/Kinshasa
APP_LOCALE=fr

# Adresse du frontend (liens des e-mails) et seules origines autorisées à appeler l'API (séparées par des virgules)
FRONTEND_URL=https://<suivi.domaine.cd>
CORS_ALLOWED_ORIGINS=https://<suivi.domaine.cd>

# Super-administrateur créé par « php artisan prise:create-super-admin »
SUPER_ADMIN_EMAIL=<adresse.du.super.admin@domaine.cd>

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Compte MySQL dédié, limité à cette base (jamais root) : voir docs/DEPLOIEMENT_SECURISE.md
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Le SMTP de chaque projet se règle dans l'application (Paramètres), mot de passe chiffré avec APP_KEY.
MAIL_MAILER=smtp
