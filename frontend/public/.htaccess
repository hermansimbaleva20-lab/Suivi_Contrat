# Application React (SPA) : toutes les routes sont servies par index.html (hébergement Apache / cPanel / WAMP)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # En production derrière HTTPS, décommentez pour rediriger tout accès HTTP :
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fichiers qui n'ont rien à faire sur le serveur web
<FilesMatch "(^\.|\.(env|log|sql|gz|bak|map|ini|md)$)">
  Require all denied
</FilesMatch>

# En-têtes de sécurité. La politique de contenu (CSP) n'autorise que les scripts de l'application ; l'adresse de l'API y est
# écrite à la compilation (vite.config.js, à partir de VITE_API_URL). Polices Google, fond de carte OpenStreetMap et
# limites des provinces (raw.githubusercontent.com) sont les seules ressources externes.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' __API_ORIGIN__ https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always unset X-Powered-By
  # index.html n'est jamais gardé en cache : une nouvelle version est prise tout de suite.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
